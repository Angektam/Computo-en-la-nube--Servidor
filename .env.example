# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── AWS — Región ─────────────────────────────────────────────
# Misma región para EC2, RDS y S3
AWS_REGION=mx-central-1

# ─── AWS — Credenciales (solo para desarrollo local) ──────────
# En EC2 con IAM Role adjunto, estas variables NO son necesarias.
# Para desarrollo local, crear un usuario IAM con permisos S3 y RDS.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# ─── Amazon RDS — PostgreSQL ──────────────────────────────────
# Obtener en: RDS → Tu instancia → Connectivity & security → Endpoint
DB_HOST=tu-instancia.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=inventario
DB_USER=postgres
DB_PASSWORD=your_rds_password
DB_SSL=true

# ─── Amazon S3 — Almacenamiento de archivos ───────────────────
# Obtener en: S3 → Tu bucket → Properties → Bucket name
S3_BUCKET=inventario-archivos-losrojos

# ─── JWT (autenticación propia) ───────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=8h
